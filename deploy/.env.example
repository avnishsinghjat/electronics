# Copy to deploy/.env and set a strong password before the first start.
FABTRACK_VERSION=0.0.1
POSTGRES_USER=fabtrack
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fabtrack
FABTRACK_HTTP_PORT=8080
FABTRACK_LOG_LEVEL=INFO
# Keep ON unless OpenRouter use is explicitly approved for this site.
FABTRACK_AIR_GAPPED=true
