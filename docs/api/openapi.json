  "info": {
    "title": "FabTrack API",
    "version": "0.0.1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "description": "Version, database status, free disk in DATA_DIR and LLM provider status.\n\nPublic (no auth): used by Docker health checks and the top-bar status indicator.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "System health",
        "tags": [
          "system"
        ]
      }
    }
  }
}
