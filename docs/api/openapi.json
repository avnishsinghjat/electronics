            "$ref": "#/components/schemas/DatabaseHealth"
          },
          "disk": {
            "$ref": "#/components/schemas/DiskHealth"
          },
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "llm": {
            "$ref": "#/components/schemas/LlmHealth"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "environment",
          "air_gapped",
          "database",
          "disk",
          "llm"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "LlmHealth": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
