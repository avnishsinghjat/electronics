# Copy to backend/.env for local development. All variables use the FABTRACK_ prefix.
FABTRACK_ENV=development
FABTRACK_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fabtrack
FABTRACK_DATA_DIR=./var/data
FABTRACK_LOG_LEVEL=INFO
FABTRACK_LOG_JSON=true
# Air-gapped mode blocks every outbound network call at the LLM gateway. Keep ON unless
# OpenRouter is explicitly approved for this site.
FABTRACK_AIR_GAPPED=true
FABTRACK_WORKER_HEARTBEAT_FILE=./var/worker.heartbeat
# Tests: the harness creates and drops a throwaway database on this server per session.
FABTRACK_TEST_DATABASE_ADMIN_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
